# Образец .env для локального запуска. Скопируйте в .env и впишите свои значения.
OPENAI_API_KEY=
# Соль для обезличенного кода диалога в журнале: любая длинная случайная строка.
USER_HASH_SALT=
# Только для отдельной демо-страницы frontend/index.html (на сайте виджет ходит через сам сайт).
ALLOWED_ORIGINS=http://127.0.0.1:8080
# Остальное можно не трогать, значения по умолчанию — в backend/config.py:
# CHAT_MODEL=gpt-4.1-mini  EMBED_MODEL=text-embedding-3-large  TOP_K=6  MIN_SIMILARITY=0.30  REWRITE_FOLLOWUPS=1
# HISTORY_TURNS=3  MEMORY_TTL_MINUTES=30  RATE_PER_MINUTE=8  RATE_PER_DAY=80  DAILY_CAP=1500  RETENTION_DAYS=90
