[Unit]
Description=FAQ assistant: delete journal records older than the retention period

[Service]
Type=oneshot
User=faq
Group=faq
WorkingDirectory=/opt/faq-assistant
EnvironmentFile=/etc/faq-assistant.env
Environment=STATE_DIR=/var/lib/faq-assistant
ExecStart=/opt/faq-assistant/.venv/bin/python -m backend.cleanup
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/faq-assistant
